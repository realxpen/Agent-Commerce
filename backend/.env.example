NODE_ENV=development
SERVICE_NAME=agent-commerce-backend
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentcommerce?schema=public

REDIS_URL=redis://localhost:6379
REDIS_PREFIX=agent-commerce

INITIA_RPC_URL=http://localhost:26657
INDEXER_EVM_RPC_URL=http://localhost:8545
INDEXER_CHAIN_ID=4273954181916632
NEXT_PUBLIC_APPCHAIN_INTERWOVEN_CHAIN_ID=agentcommerce-1
NEXT_PUBLIC_APPCHAIN_TENDERMINT_RPC_URL=http://localhost:26657
NEXT_PUBLIC_APPCHAIN_REST_URL=http://localhost:1317
NEXT_PUBLIC_APPCHAIN_INDEXER_URL=http://localhost:8080
NEXT_PUBLIC_APPCHAIN_DISPLAY_NAME=AgentCommerce
AGENT_REGISTRY_CONTRACT_ADDRESS=
SERVICE_ESCROW_CONTRACT_ADDRESS=
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_CONFIRMATIONS=1
INDEXER_BATCH_SIZE=2000
INDEXER_LOOKBACK_BLOCKS=2000
INDEXER_START_BLOCK=
INDEXER_NATIVE_TOKEN_DECIMALS=18
INDEXER_NATIVE_TOKEN_DENOM=GAS
WEBHOOK_SECRET=change-me
JWT_SECRET=change-me-with-at-least-32-characters
JWT_ISSUER=agent-commerce-backend
JWT_AUDIENCE=agent-commerce-app
AUTH_CHALLENGE_TTL_SECONDS=600
AUTH_TOKEN_TTL_SECONDS=604800
AUTH_MESSAGE_DOMAIN=AgentCommerce
AUTH_MESSAGE_URI=http://localhost:3000
AUTH_MESSAGE_STATEMENT=Sign this message to authenticate with AgentCommerce.

LLM_PROVIDER=openai
LLM_REQUEST_TIMEOUT_MS=45000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
GEMINI_CODE_EXECUTION_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
BACKEND_PUBLIC_BASE_URL=http://localhost:4000
UPLOAD_STORAGE_DIR=storage/uploads
UPLOAD_MAX_BYTES=26214400
ARTIFACT_STORAGE_DIR=storage/artifacts

DEMO_FAUCET_ENABLED=false
DEMO_FAUCET_REQUIRE_AUTH=true
DEMO_FAUCET_CLI_PATH=minitiad
DEMO_FAUCET_CHAIN_ID=agentcommerce-1
DEMO_FAUCET_AMOUNT=10000000000000000000GAS
DEMO_FAUCET_KEY_NAME=gas-station
DEMO_FAUCET_KEYRING_BACKEND=test
DEMO_FAUCET_RATE_LIMIT_WINDOW_SECONDS=86400
DEMO_FAUCET_MAX_REQUESTS_PER_WINDOW=1
DEMO_FAUCET_ALLOWED_ADDRESS_PREFIX=init
DEMO_FAUCET_ADMIN_TOKEN=
