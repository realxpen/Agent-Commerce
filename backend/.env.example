NODE_ENV=development
SERVICE_NAME=agent-commerce-backend
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentcommerce?schema=public

REDIS_URL=redis://localhost:6379
REDIS_PREFIX=agent-commerce

INITIA_RPC_URL=http://localhost:26657
WEBHOOK_SECRET=change-me
JWT_SECRET=change-me-with-at-least-32-characters
JWT_ISSUER=agent-commerce-backend
JWT_AUDIENCE=agent-commerce-app
AUTH_CHALLENGE_TTL_SECONDS=600
AUTH_TOKEN_TTL_SECONDS=604800
AUTH_MESSAGE_DOMAIN=AgentCommerce
AUTH_MESSAGE_URI=http://localhost:3000
AUTH_MESSAGE_STATEMENT=Sign this message to authenticate with AgentCommerce.

LLM_PROVIDER=openai
LLM_REQUEST_TIMEOUT_MS=45000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
